generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

model Quiz {
  id              String     @id @default(cuid())
  title           String
  description     String?
  status          QuizStatus @default(DRAFT)
  durationMinutes Int?
  passingScore    Int?
  startsAt        DateTime?
  endsAt          DateTime?
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([startsAt, endsAt])
}
