datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// -----------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  ABANDONED
}

enum UserRole {
  STUDENT
  ADMIN
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  RETRYING
  SKIPPED
}

enum NotificationTemplateKey {
  VERIFICATION
  QUIZ_INVITATION
  QUIZ_REMINDER
  PASSWORD_RESET
}

enum InvitationStatus {
  PENDING
  CLAIMED
  EXPIRED
}

enum CheatingEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  WINDOW_FOCUS
  FULLSCREEN_EXIT
  COPY_PASTE
  OTHER
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_TEXT
  ESSAY
  MULTI_SELECT
  CODE_CONTEXT
  FILL_BLANK
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum GradingStatus {
  PARTIAL
  COMPLETE
}

enum ScoreStrategy {
  BEST
  LATEST
}

// -----------------------------------------------------------------------
// Attempt
// -----------------------------------------------------------------------

model Attempt {
  id        String         @id @default(cuid())
  quizId    String
  quiz      Quiz           @relation(fields: [quizId], references: [id])
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [userId])

  /// Wall-clock time when the student started the attempt.
  startedAt DateTime @default(now())

  /// Persisted deadline calculated from the quiz duration when the attempt starts.
  expiresAt DateTime

  /// Set when the attempt is finalised; null while in-progress.
  submittedAt DateTime?

  status AttemptStatus @default(IN_PROGRESS)

  /// Populated by the scoring service after submission.
  score    Int?
  maxScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers AttemptAnswer[]
  result  Result?

  @@index([studentId])
  @@index([quizId])
  @@index([studentId, quizId])
  @@index([status, expiresAt])
  @@map("attempts")


}

// CheatingEventLog intentionally keeps a raw attemptId (no Prisma relation).

// -----------------------------------------------------------------------
// AttemptAnswer
// -----------------------------------------------------------------------

model AttemptAnswer {
  id        String @id @default(cuid())
  attemptId String

  questionId        String
  question          Question @relation(fields: [questionId], references: [id])
  /// The option the student chose; null means the question was skipped.
  selectedOptionId  String?
  /// For MULTI_SELECT: selectedOptionIds
  selectedOptionIds String[] @default([])
  /// Free-text response for SHORT_TEXT and ESSAY questions.
  textAnswer        String?

  /// Populated by the scoring service; null until graded.
  isCorrect Boolean?

  /// Points awarded for this answer; null while an essay awaits manual grading.
  pointsEarned Int?

  /// Admin who graded an essay answer.
  gradedById String?
  gradedAt   DateTime?

  /// Updated on every upsert so the solving module can track last save.
  answeredAt DateTime @default(now())

  /// Snapshot — frozen at submit time for immutability
  snapshotCodeSnippet  String?
  snapshotCodeLanguage String?
  snapshotText           String?
  snapshotOptions        String[]      @default([])
  snapshotCorrectAnswer  String?
  snapshotCorrectAnswers String[]      @default([])
  snapshotType           QuestionType?
  snapshotPoints         Int?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("attempt_answers")
}

model EmailDeliveryLog {
  id                String                  @id @default(cuid())
  recipientEmail    String
  subject           String
  templateKey       NotificationTemplateKey
  status            EmailDeliveryStatus     @default(PENDING)
  correlationId     String?
  errorMessage      String?
  attemptCount      Int                     @default(0)
  providerMessageId String?
  metadata          Json?
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  invitationId String?
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([templateKey, recipientEmail])
  @@index([correlationId])
  @@index([invitationId])
  @@map("email_delivery_logs")
}

model Quiz {
  id              String           @id @default(cuid())
  title           String
  description     String?
  status          QuizStatus       @default(DRAFT)
  durationMinutes Int?
  passingScore    Int?
  startsAt        DateTime?
  endsAt          DateTime?
  /// Topic/category labels (e.g. "midterm", "arrays") used to scope the
  /// cohort distribution view and the filtered CSV export. Defaults to
  /// an empty array — never null — so `tags: { hasSome: [...] }` filters
  /// behave predictably against untagged quizzes (they simply never match).
  tags            String[]   @default([])
    /// Max submitted attempts per student; null = unlimited.
  maxAttempts Int?
  /// Official score resolution when multiple attempts exist.
  scoreStrategy ScoreStrategy @default(LATEST)
  createdById     String?
  creator         User?            @relation(fields: [createdById], references: [id])
  quizQuestions   QuizQuestion[]
  attempts        Attempt[]
  students        StudentProfile[]
  invitations     Invitation[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([startsAt, endsAt])
  @@map("quizzes")
}

model CheatingEventLog {
  id          String            @id @default(cuid())
  attemptId   String
  eventType   CheatingEventType
  description String?
  metadata    Json?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@index([attemptId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("cheating_event_logs")
}

model User {
  id                         String    @id @default(cuid())
  email                      String    @unique
  passwordHash               String    @map("password_hash")
  name                       String?   @map("full_name")
  role                       UserRole  @default(STUDENT)
  emailVerified              Boolean   @default(false) @map("email_verified")
  verificationToken          String?   @unique @map("verification_token")
  verificationTokenExpiresAt DateTime? @map("verification_token_expires_at")
  lastVerificationSentAt     DateTime? @map("last_verification_sent_at")
  isActive                   Boolean   @default(true) @map("is_active")
  tokenVersion               Int       @default(0) @map("token_version")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  quizzes             Quiz[]
  studentProfile      StudentProfile?
  invitations         Invitation[]
  passwordResetTokens PasswordResetToken[]
  signInActivities    SignInActivity[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model SignInActivity {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  signedInAt DateTime @default(now()) @map("signed_in_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, signedInAt])
  @@index([signedInAt])
  @@map("sign_in_activities")
}

model StudentProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Free-text cohort/batch label (e.g. "2026-Batch-A"), used to scope
  /// cohort distribution reporting and the filtered CSV export. Nullable —
  /// students not yet assigned to a cohort are simply excluded when a
  /// cohort filter is applied, never coerced into a fake bucket.
  cohort String?

  attempts Attempt[]
  quizzes  Quiz[]

  @@index([cohort])
  @@map("student_profiles")
}

model Question {
  id             String       @id @default(cuid())
  type           QuestionType
  text           String
  options        String[]
  correctAnswer  String       @default("")
  correctAnswers String[]     @default([])
  points         Int          @default(1)
  difficulty     Difficulty   @default(MEDIUM)
  topic          String?
  tags           String[]     @default([])
  /// For CODE_CONTEXT: read-only code block shown to the student.
  codeSnippet  String?
  codeLanguage String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attemptAnswers AttemptAnswer[]
  quizQuestions  QuizQuestion[]

  @@map("questions")
}

model QuizQuestion {
  quizId     String
  questionId String
  order      Int?

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([quizId, questionId])
  @@index([quizId])
  @@index([questionId])
  @@map("quiz_questions")
}

// Result model — populated by ScoringService after submission
model Result {
  id                String        @id @default(cuid())
  attemptId         String        @unique
  studentId         String
  quizId            String
  score             Int
  maxScore          Int
  percentage        Float
  passed            Boolean?
  gradingStatus     GradingStatus @default(COMPLETE)
  pendingEssayCount Int           @default(0)
  gradedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  attempt           Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([quizId])
  @@index([passed])
  @@map("results")
}

model Invitation {
  id             String           @id @default(cuid())
  quizId         String
  recipientEmail String
  userId         String?
  status         InvitationStatus @default(PENDING)

  createdAt DateTime  @default(now())
  claimedAt DateTime?
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt

  quiz Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  emailDeliveryLogs EmailDeliveryLog[]

  @@unique([quizId, recipientEmail])
  @@index([recipientEmail, status])
  @@index([userId, status])
  @@index([quizId, status])
  @@map("invitations")
}
// OrganizationSettings model — singleton for institutional defaults
model OrganizationSettings {
  id                       String   @id @default("default")
  organizationName         String   @default("PitIQ")
  timezoneLabel            String   @default("UTC")
  defaultPassThreshold     Int      @default(50)
  defaultDurationMinutes   Int      @default(60)
  integrityReviewThreshold Int      @default(3)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("organization_settings")
}

