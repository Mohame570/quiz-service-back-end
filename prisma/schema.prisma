datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// -----------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  ABANDONED
}

enum UserRole {
  STUDENT
  ADMIN
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum NotificationTemplateKey {
  VERIFICATION
  QUIZ_INVITATION
}

enum CheatingEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  WINDOW_FOCUS
  FULLSCREEN_EXIT
  COPY_PASTE
  OTHER
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
}

// -----------------------------------------------------------------------
// Attempt
// -----------------------------------------------------------------------

model Attempt {
  id        String        @id @default(cuid())
  quizId    String
  quiz      Quiz          @relation(fields: [quizId], references: [id])
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [userId])

  /// Wall-clock time when the student started the attempt.
  startedAt DateTime @default(now())

  /// Persisted deadline calculated from the quiz duration when the attempt starts.
  expiresAt DateTime

  /// Set when the attempt is finalised; null while in-progress.
  submittedAt DateTime?

  status AttemptStatus @default(IN_PROGRESS)

  /// Populated by the scoring service after submission.
  score    Int?
  maxScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers AttemptAnswer[]

  @@index([studentId])
  @@index([quizId])
  @@index([studentId, quizId])
  @@index([status, expiresAt])
  @@map("attempts")
}

// CheatingEventLog intentionally keeps a raw attemptId (no Prisma relation).

// -----------------------------------------------------------------------
// AttemptAnswer
// -----------------------------------------------------------------------

model AttemptAnswer {
  id        String @id @default(cuid())
  attemptId String

  questionId       String
  question         Question @relation(fields: [questionId], references: [id])
  /// The option the student chose; null means the question was skipped.
  selectedOptionId String?

  /// Populated by the scoring service; null until graded.
  isCorrect Boolean?

  /// Updated on every upsert so the solving module can track last save.
  answeredAt DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("attempt_answers")
}

model EmailDeliveryLog {
  id                String                  @id @default(cuid())
  recipientEmail    String
  subject           String
  templateKey       NotificationTemplateKey
  status            EmailDeliveryStatus     @default(PENDING)
  correlationId     String?
  errorMessage      String?
  attemptCount      Int                     @default(0)
  providerMessageId String?
  metadata          Json?
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([templateKey, recipientEmail])
  @@index([correlationId])
  @@map("email_delivery_logs")
}

model Quiz {
  id              String     @id @default(cuid())
  title           String
  description     String?
  status          QuizStatus @default(DRAFT)
  durationMinutes Int?
  passingScore    Int?
  startsAt        DateTime?
  endsAt          DateTime?
  createdById     String?
  creator         User?      @relation(fields: [createdById], references: [id])
  questions       Question[]
  attempts        Attempt[]
  students        StudentProfile[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([startsAt, endsAt])
  @@map("quizzes")
}

model CheatingEventLog {
  id          String            @id @default(cuid())
  attemptId   String
  eventType   CheatingEventType
  description String?
  metadata    Json?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@index([attemptId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("cheating_event_logs")
}

model User {
  id                         String    @id @default(cuid())
  email                      String    @unique
  passwordHash               String    @map("password_hash")
  name                       String?   @map("full_name")
  role                       UserRole  @default(STUDENT)
  emailVerified              Boolean   @default(false) @map("email_verified")
  verificationToken          String?   @unique @map("verification_token")
  verificationTokenExpiresAt DateTime? @map("verification_token_expires_at")
  isActive                   Boolean   @default(true) @map("is_active")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  quizzes        Quiz[]
  studentProfile StudentProfile?

  @@map("users")
}

model StudentProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  attempts Attempt[]
  quizzes  Quiz[]

  @@map("student_profiles")
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          QuestionType
  text          String
  options       String[]
  correctAnswer String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  attemptAnswers AttemptAnswer[]

  @@index([quizId])
  @@map("questions")
}
