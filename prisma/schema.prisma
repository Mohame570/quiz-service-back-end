datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// -----------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  ABANDONED
}

// -----------------------------------------------------------------------
// Attempt
// -----------------------------------------------------------------------

model Attempt {
  id          String        @id @default(uuid()) @db.Uuid
  quizId      String        @db.Uuid
  studentId   String        @db.Uuid

  /// Wall-clock time when the student started the attempt.
  startedAt   DateTime      @default(now())

  /// Set when the attempt is finalised; null while in-progress.
  submittedAt DateTime?

  status      AttemptStatus @default(IN_PROGRESS)

  /// Populated by the scoring service after submission.
  score       Int?
  maxScore    Int?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  answers     AttemptAnswer[]

  @@index([studentId])
  @@index([quizId])
  @@index([studentId, quizId])
  @@map("attempts")
}

// -----------------------------------------------------------------------
// AttemptAnswer
// -----------------------------------------------------------------------

model AttemptAnswer {
  id               String   @id @default(uuid()) @db.Uuid
  attemptId        String   @db.Uuid
  questionId       String   @db.Uuid

  /// The option the student chose; null means the question was skipped.
  selectedOptionId String?  @db.Uuid

  /// Populated by the scoring service; null until graded.
  isCorrect        Boolean?

  /// Updated on every upsert so the solving module can track last save.
  answeredAt       DateTime @default(now())

  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("attempt_answers")
}
enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum NotificationTemplateKey {
  VERIFICATION
  QUIZ_INVITATION
}

enum CheatingEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  WINDOW_FOCUS
  FULLSCREEN_EXIT
  COPY_PASTE
  OTHER
}

model EmailDeliveryLog {
  id                String                  @id @default(cuid())
  recipientEmail    String
  subject           String
  templateKey       NotificationTemplateKey
  status            EmailDeliveryStatus     @default(PENDING)
  correlationId     String?
  errorMessage      String?
  attemptCount      Int                     @default(0)
  providerMessageId String?
  metadata          Json?
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([templateKey, recipientEmail])
  @@index([correlationId])
  @@map("email_delivery_logs")
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

model Quiz {
  id              String     @id @default(cuid())
  title           String
  description     String?
  status          QuizStatus @default(DRAFT)
  durationMinutes Int?
  passingScore    Int?
  startsAt        DateTime?
  endsAt          DateTime?
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([startsAt, endsAt])
}

model CheatingEventLog {
  id          String            @id @default(cuid())
  attemptId   String
  eventType   CheatingEventType
  description String?
  metadata    Json?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@index([attemptId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("cheating_event_logs")
}

enum QuestionType {
  MCQ
  TRUE_FALSE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  quizzes   Quiz[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Quiz {
  id          String     @id @default(cuid())
  title       String
  description String?
  creatorId   String
  creator     User       @relation(fields: [creatorId], references: [id])
  questions   Question[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([creatorId])
  @@map("quizzes")
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          QuestionType
  text          String
  options       String[]
  correctAnswer String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([quizId])
  @@map("questions")
}
