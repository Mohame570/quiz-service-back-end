generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum NotificationTemplateKey {
  VERIFICATION
  QUIZ_INVITATION
}

enum CheatingEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  WINDOW_FOCUS
  FULLSCREEN_EXIT
  COPY_PASTE
  OTHER
}

model EmailDeliveryLog {
  id                String                  @id @default(cuid())
  recipientEmail    String
  subject           String
  templateKey       NotificationTemplateKey
  status            EmailDeliveryStatus     @default(PENDING)
  correlationId     String?
  errorMessage      String?
  attemptCount      Int                     @default(0)
  providerMessageId String?
  metadata          Json?
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([templateKey, recipientEmail])
  @@index([correlationId])
  @@map("email_delivery_logs")
}

model CheatingEventLog {
  id          String            @id @default(cuid())
  attemptId   String
  eventType   CheatingEventType
  description String?
  metadata    Json?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@index([attemptId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("cheating_event_logs")
}
