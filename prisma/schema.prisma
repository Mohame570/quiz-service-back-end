generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum NotificationTemplateKey {
  VERIFICATION
  QUIZ_INVITATION
}

enum CheatingEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  WINDOW_FOCUS
  FULLSCREEN_EXIT
  COPY_PASTE
  OTHER
}

model EmailDeliveryLog {
  id                String                  @id @default(cuid())
  recipientEmail    String                  @map("recipient_email")
  subject           String
  templateKey       NotificationTemplateKey @map("template_key")
  status            EmailDeliveryStatus     @default(PENDING)
  correlationId     String?                 @map("correlation_id")
  errorMessage      String?                 @map("error_message")
  attemptCount      Int                     @default(0) @map("attempt_count")
  providerMessageId String?                 @map("provider_message_id")
  metadata          Json?
  lastAttemptAt     DateTime?               @map("last_attempt_at")
  deliveredAt       DateTime?               @map("delivered_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([templateKey, recipientEmail])
  @@index([correlationId])
  @@map("email_delivery_logs")
}

model CheatingEventLog {
  id          String            @id @default(cuid())
  attemptId   String            @map("attempt_id")
  eventType   CheatingEventType @map("event_type")
  description String?
  metadata    Json?
  occurredAt  DateTime          @default(now()) @map("occurred_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([attemptId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("cheating_event_logs")
}

enum QuestionType {
  MCQ
  TRUE_FALSE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  quizzes   Quiz[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Quiz {
  id          String     @id @default(cuid())
  title       String
  description String?
  creatorId   String     @map("creator_id")
  creator     User       @relation(fields: [creatorId], references: [id])
  questions   Question[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([creatorId])
  @@map("quizzes")
}

model Question {
  id            String           @id @default(cuid())
  quizId        String           @map("quiz_id")
  quiz          Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          QuestionType
  text          String
  options       QuestionOption[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([quizId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([questionId])
  @@map("question_options")
}
