{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "src/.*\\.spec\\.ts$",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "test/tsconfig.jest.json"
      }
    ]
  },
  "collectCoverageFrom": ["src/**/*.ts"],
  "coverageDirectory": "coverage",
  "testEnvironment": "node"
}
