          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.questions && json.questions.length > 0) {",
                  "  pm.collectionVariables.set('questionId', json.questions[0].id);",
                  "}"
                ]
              }
            }
          ],
