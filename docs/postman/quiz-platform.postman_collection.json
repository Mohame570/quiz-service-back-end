            {
              "name": "200 Active attempt present",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"attempt\": {\n    \"attemptId\": \"cm1attempt0000000000000abc\",\n    \"quizId\": \"cm1quiz00000000000000abc\",\n    \"startedAt\": \"2026-06-23T10:00:00.000Z\",\n    \"expiresAt\": \"2026-06-23T10:30:00.000Z\"\n  }\n}"
