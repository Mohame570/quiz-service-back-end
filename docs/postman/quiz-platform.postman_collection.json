            {
              "name": "200 No active attempt",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"attempt\": null\n}"
            }
          ]
        },
        {
          "name": "GET /student/attempts/:attemptId/questions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/student/attempts/:attemptId/questions",
              "host": ["{{baseUrl}}"],
              "path": ["student", "attempts", ":attemptId", "questions"],
              "variable": [
