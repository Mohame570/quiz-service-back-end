          }
        }
      ]
    },
    {
      "name": "Integrity (Admin)",
      "description": "Suspicious attempts monitoring — flag attempts exceeding cheating-event threshold, view event timelines.",
      "item": [
        {
          "name": "Log Cheating Event",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/integrity/events",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attemptId\": \"{{attemptId}}\",\n  \"eventType\": \"TAB_HIDDEN\",\n  \"description\": \"Student switched to another tab\"\n}"
            }
          }
        },
        {
          "name": "Get Suspicious Attempts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var data = JSON.parse(responseBody);",
                  "pm.test('Returns array', () => pm.expect(data).to.be.an('array'));",
                  "pm.test('Attempts have required fields', () => {",
                  "  if (data.length > 0) {",
                  "    pm.expect(data[0]).to.have.property('attemptId');",
                  "    pm.expect(data[0]).to.have.property('studentName');",
                  "    pm.expect(data[0]).to.have.property('eventCount');",
                  "    pm.expect(data[0]).to.have.property('events');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/integrity/suspicious?threshold=3",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "integrity", "suspicious"],
              "query": [
                { "key": "threshold", "value": "3" },
                { "key": "quizId", "value": "", "disabled": true }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Attempt Cheating Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/integrity/attempts/{{attemptId}}/events",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Notifications (Admin)",
      "description": "Email delivery monitoring — delivery summary stats, per-quiz invitation status.",
      "item": [
        {
          "name": "Get Delivery Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var data = JSON.parse(responseBody);",
                  "pm.test('Has overall stats', () => {",
                  "  pm.expect(data.overall).to.have.property('total');",
                  "  pm.expect(data.overall).to.have.property('sent');",
                  "  pm.expect(data.overall).to.have.property('failed');",
                  "  pm.expect(data.overall).to.have.property('pending');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/notifications/delivery-summary",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Invitation Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/notifications/invitation-status",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "List Delivery Logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications/delivery-logs",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Resend Failed",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notifications/delivery-logs/resend-failed",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateKey\": \"VERIFICATION\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Student",
      "description": "Student-facing endpoints. Use Login (Student) first. Question types: MCQ/TRUE_FALSE → selectedOptionId; SHORT_TEXT/ESSAY → textAnswer.",
      "item": [
        {
          "name": "Login (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = JSON.parse(responseBody);",
                  "pm.collectionVariables.set('token', data.tokens.accessToken);",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            }
          }
        },
        {
          "name": "List Available Quizzes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student/quizzes",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Accept Quiz Invitation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/student/quizzes/{{quizId}}/accept-invitation",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Quiz Details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student/quizzes/{{quizId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Start Quiz Attempt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = JSON.parse(responseBody);",
                  "pm.collectionVariables.set('attemptId', data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/student/quizzes/{{quizId}}/start",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Attempt Questions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = JSON.parse(responseBody);",
                  "if (data.questions && data.questions.length > 0) {",
                  "  var mcq = data.questions.find(function(q) { return q.type === 'MCQ'; }) || data.questions[0];",
                  "  var shortText = data.questions.find(function(q) { return q.type === 'SHORT_TEXT'; });",
                  "  var essay = data.questions.find(function(q) { return q.type === 'ESSAY'; });",
                  "  pm.collectionVariables.set('questionId', mcq.id);",
                  "  if (shortText) pm.collectionVariables.set('questionIdShortText', shortText.id);",
                  "  if (essay) pm.collectionVariables.set('questionIdEssay', essay.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student/attempts/{{attemptId}}/questions",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Save Answers (Choice — MCQ/TRUE_FALSE)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/student/attempts/{{attemptId}}/answers",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    { \"questionId\": \"{{questionId}}\", \"selectedOptionId\": \"let\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Save Answers (Text — SHORT_TEXT/ESSAY)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/student/attempts/{{attemptId}}/answers",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    { \"questionId\": \"{{questionIdShortText}}\", \"textAnswer\": \"object\" },\n    { \"questionId\": \"{{questionIdEssay}}\", \"textAnswer\": \"let is block-scoped; var is function-scoped.\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Submit Attempt",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/student/attempts/{{attemptId}}/submit",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": []\n}"
            }
          }
        },
        {
          "name": "Get Attempt Result",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student/attempts/{{attemptId}}/result",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Active Attempts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/student/attempts/active",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "description": "Admin analytics — quiz stats, attempts, events, and essay grading.\n\nEssay grading flow (login as admin1@example.com first):\n1. Get Essay Grading Queue — seeded student1 attempt on new-quiz-5 (PARTIAL)\n2. Get Attempt for Grading — copy essay answerId where pendingManualGrade is true\n3. Grade Essay Answer — PATCH pointsEarned; result becomes COMPLETE when done",
      "item": [
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/analytics",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Quiz Attempts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/analytics/quizzes/{{quizTitle}}/attempts",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Analytics Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/analytics/events",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Essay Grading Queue",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/analytics/grading/queue",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Attempt for Grading",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/analytics/grading/attempts/{{attemptId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Grade Essay Answer",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/analytics/grading/attempts/{{attemptId}}/answers/{{answerId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pointsEarned\": 1\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "description": "Health check endpoint.",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Service OK', () => {",
                  "  var data = JSON.parse(responseBody);",
                  "  pm.expect(data.status).to.eql('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    }
  ]
}
