            "method": "POST",
            "url": "{{baseUrl}}/questions",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quizId\": \"{{quizId}}\",\n  \"type\": \"MCQ\",\n  \"text\": \"What is the capital of France?\",\n  \"options\": [\"London\", \"Paris\", \"Berlin\", \"Madrid\"],\n  \"correctAnswer\": \"Paris\"\n}"
            }
          }
        },
        {
          "name": "Create Question (TRUE_FALSE)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/questions",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quizId\": \"{{quizId}}\",\n  \"type\": \"TRUE_FALSE\",\n  \"text\": \"The Earth is flat.\",\n  \"options\": [\"True\", \"False\"],\n  \"correctAnswer\": \"False\"\n}"
            }
          }
        },
        {
          "name": "Create Question (SHORT_TEXT)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/questions",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quizId\": \"{{quizId}}\",\n  \"type\": \"SHORT_TEXT\",\n  \"text\": \"Name the capital of France.\",\n  \"correctAnswer\": \"Paris\"\n}"
            }
          }
        },
        {
          "name": "Create Question (ESSAY)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/questions",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quizId\": \"{{quizId}}\",\n  \"type\": \"ESSAY\",\n  \"text\": \"Explain REST in your own words.\"\n}"
            }
          }
        },
        {
          "name": "Update Question",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/questions/{{questionId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Updated question text\"\n}"
            }
          }
        },
        {
          "name": "Delete Question",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/questions/{{questionId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Attempts & Scoring",
      "description": "Quiz attempts — start, answer, submit, get results.",
      "item": [
        {
          "name": "Start Attempt",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/attempts",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quizId\": \"{{quizId}}\"\n}"
            }
          }
        },
        {
          "name": "List My Attempts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/attempts",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Attempt",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/attempts/{{attemptId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Save Answers (Choice — MCQ/TRUE_FALSE)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/attempts/{{attemptId}}/answers",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    { \"questionId\": \"{{questionId}}\", \"selectedOptionId\": \"Paris\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Save Answers (Text — SHORT_TEXT/ESSAY)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/attempts/{{attemptId}}/answers",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    { \"questionId\": \"{{questionIdShortText}}\", \"textAnswer\": \"Paris\" },\n    { \"questionId\": \"{{questionIdEssay}}\", \"textAnswer\": \"REST is an architectural style for building APIs.\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Submit Attempt",
          "request": {
            "method": "POST",
