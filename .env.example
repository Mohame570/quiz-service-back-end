NODE_ENV=development
PORT=3002
APP_NAME=Quiz Service Backend
API_PREFIX=api
FRONTEND_BASE_URL=http://localhost:3001
FRONTEND_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

POSTGRES_DB=quiz_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port for the Compose Postgres service (5432 is often taken by other local DBs)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/quiz_service?schema=public

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com

JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_IN=1h
